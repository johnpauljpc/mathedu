# Copy this file to `.env` and fill in your values.
# Never commit the real `.env` — it is git-ignored.

# REQUIRED in production. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
DJANGO_SECRET_KEY=replace-me

# Set to True only for local development.
DJANGO_DEBUG=False

# Comma-separated list of allowed hosts.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,mathedu.pythonanywhere.com

# Optional: root log level (DEBUG, INFO, WARNING, ERROR).
DJANGO_LOG_LEVEL=INFO